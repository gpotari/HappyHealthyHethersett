# Copy to ~/.config/happy-healthy-hethersett/api.env on the Mac that runs the API.
# The install script creates that file automatically if it does not already exist.

ASPNETCORE_URLS='http://localhost:5000'
ASPNETCORE_ENVIRONMENT='Production'

ConnectionStrings__DefaultConnection='Server=localhost;Port=3306;Database=happy_healthy_hethersett;User=hhh_app;Password=change-me;'

# Only needed before the first API run, when there are no users yet.
# Remove or comment these after the first admin has been created.
# HHH_INITIAL_ADMIN_EMAIL='admin@example.com'
# HHH_INITIAL_ADMIN_PASSWORD='choose-a-long-temporary-password'

# Optional, if dotnet is installed somewhere unusual.
# HHH_DOTNET_BIN='/opt/homebrew/opt/dotnet@8/libexec/dotnet'

# Optional, enables browser push reminders for signed-in litter pick volunteers.
# Generate a VAPID key pair, then set these before starting the API.
# HHH_VAPID_PUBLIC_KEY='public-key-from-vapid-generator'
# HHH_VAPID_PRIVATE_KEY='private-key-from-vapid-generator'
# HHH_VAPID_SUBJECT='mailto:admin@example.com'
